# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Organized by setup level. Fill in sections for your chosen setup:
#   - Core: Downloads + Jellyfin (required)
#   - + local DNS: Adds .lan/.local domains and ad-blocking (optional)
#   - + remote access: Adds external access from anywhere (optional)
# =============================================================================

# =============================================================================
# CORE (required for all setups)
# =============================================================================

# Stack directory - where this repo lives on the NAS
# Used by scripts for paths to compose files, configs, and logs
# volume2 is the SSD pool - all container/docker files live here, keeping
# volume1 (HDD pool) reserved for media only.
NAS_STACK_DIR=/volume2/docker/arr-stack

# Media storage root path - the HDD pool
MEDIA_ROOT=/volume1/data

# Timezone - used for correct scheduling, logs, and UI times across all services
TZ=Europe/Bucharest

# User/Group IDs - confirmed via `id` on this NAS:
# uid=1000(stefan) gid=10(admin)
# PGID is 10, NOT the usual 1000 default - this NAS's user has group "admin"
# (gid 10), not a personal group. Getting this wrong causes "not writable by
# user 'abc'" errors in Sonarr/Radarr once media directories are chowned to
# match below.
PUID=1000
PGID=10

# Hardware Transcoding (Intel Quick Sync) - optional
# Enables GPU-accelerated video transcoding in Jellyfin (much lower CPU usage)
# Find your render group ID: getent group render | cut -d: -f3
# Leave unset or 0 to skip hardware transcoding
RENDER_GROUP_ID=

# =============================================================================
# + LOCAL DNS (optional - adds .lan/.local domains and ad-blocking)
# =============================================================================
# Enables access like http://sonarr.lan (or http://sonarr.local, client-dependent)
# instead of http://192.168.1.50:8989
# Skip this section for Core setup (IP:port access only)

# Your NAS IP address (used for Pi-hole DNS binding) - set static in UGOS
# network settings (Control Panel -> Network), not just a router DHCP
# reservation, or Docker can start before the DHCP handshake completes and
# Pi-hole fails to bind (exit 128) on reboot.
NAS_IP=192.168.0.231

# Pi-hole Admin Password
PIHOLE_UI_PASS=your_secure_pihole_password

# Traefik's LAN IP and MAC (via macvlan network)
# This gives Traefik its own IP on your network where it can use port 80.
# Reserve TRAEFIK_LAN_IP in your router's DHCP settings against
# TRAEFIK_LAN_MAC so no other device gets assigned it.
TRAEFIK_LAN_IP=192.168.0.240

# Fixed MAC address for the DHCP reservation above (locally-administered, not
# tied to any real hardware - Docker assigns it to the macvlan interface)
TRAEFIK_LAN_MAC=02:42:0a:0a:00:0b

# Network interface name on the NAS. This NAS runs UGOS bridge mode (eth0 +
# eth1 both slaved into bridge0, which carries the actual IP/default route)
# - confirmed via `ip addr show bridge0` / `ip route`, so the macvlan must
# attach to bridge0, not eth0/eth1 directly.
LAN_INTERFACE=bridge0

# Your LAN subnet and gateway
LAN_SUBNET=192.168.0.0/24
LAN_GATEWAY=192.168.0.1

# =============================================================================
# + REMOTE ACCESS (optional - adds external access from anywhere)
# =============================================================================
# Enables access like https://jellyfin.yourdomain.com from outside your home
# Skip this section if you only need local access

# Domain Configuration
# Buy your own domain (~$10/year). Cloudflare Registrar is simplest: https://www.cloudflare.com/products/registrar/
DOMAIN=yourdomain.com

# Traefik Dashboard Authentication
# Generate with: htpasswd -nbB admin 'YOUR_PASSWORD'
# IMPORTANT: Must be quoted (contains $ which Docker interprets as variables)
TRAEFIK_DASHBOARD_AUTH='admin:$2y$05$your_bcrypt_hash_here'

# Tailscale (optional - reach the whole LAN remotely, including CGNAT/hotel WiFi)
# See docs/TAILSCALE.md for the full walkthrough. Only needed if you deploy
# docker-compose.tailscale.yml.

# Tailscale node hostname as it appears in the admin console
# TS_HOSTNAME=arr-stack-nas

# Pre-auth key for unattended setup (https://login.tailscale.com/admin/settings/keys)
# Leave unset for interactive first-run auth — recommended for personal use
# TS_AUTHKEY=tskey-auth-xxxxxxxxxxxx

# Additional subnets to advertise beyond LAN_SUBNET (comma-separated, no spaces)
# Example: also advertise the Docker arr-stack subnet for raw container access
# TS_EXTRA_ROUTES=172.20.0.0/24

# =============================================================================
# UTILITIES (optional)
# =============================================================================

# Plex (if you swap Jellyfin for Plex — see docs/SETUP.md "Prefer Plex?" section)
# Get claim token from: https://plex.tv/claim (expires in 4 minutes!)
# Only needed on first run to link server to your Plex account
# PLEX_CLAIM=claim-xxxxxxxxxxxxxxxxxxxx


# Beszel agent key (for beszel-agent in utilities.yml)
# Get from Beszel hub UI: Add System → copy KEY value
# BESZEL_KEY=

# DIUN - Docker Image Update Notifier (for diun in utilities.yml)
# Checks registries for new image versions and sends webhook notifications
# DIUN_SCHEDULE=0 6 * * *                              # When to check (cron, default: daily 6am)
# DIUN_WEBHOOK_URL=http://your-webhook-receiver/path  # Diun won't start without this

# Configarr - TRaSH Guides quality profile sync (for configarr in utilities.yml)
# Get API keys from: Sonarr/Radarr → Settings → General → API Key
# SONARR_API_KEY=
# RADARR_API_KEY=
